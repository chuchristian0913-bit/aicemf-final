  "limitations": [
    {
      "key": "period_alignment",
      "text": "Visa's fiscal year ends in September; the other four end in December. The comparison is between each company's latest annual report, not a common calendar year, and Visa's figures therefore cover a period ending roughly nine months earlier than the December year-ends."
    },
    {
      "key": "tag_change:FI:da",
      "text": "Fiserv changed the XBRL tag behind depreciation and amortisation between FY2023 and FY2024, from DepreciationDepletionAndAmortization to OtherDepreciationAndAmortization. The reported series falls from roughly $3.2bn to $1.7bn with no economic event behind it, so EBITDA-based measures are not used anywhere in this note."
    },
    {
      "key": "recast:GPN:revenue",
      "text": "Global Payments re-presented FY2023 and FY2024 after its divestitures: FY2023 revenue is $9.65bn as first filed and $7.38bn as restated in the FY2025 annual report. Growth rates spanning the recast are not like-for-like, so only the FY2023-FY2025 window is used."
    },
    {
      "key": "recast:GPN:operating_income",
      "text": "Operating income for FY2023 and FY2024 was re-presented on the same post-divestiture basis as revenue; the same window restriction applies to any margin comparison."
    },
    {
      "key": "recast:GPN:cfo",
      "text": "Cash flow from operations for FY2023 and FY2024 was re-presented following the divestitures; the FY2022 value remains on the pre-divestiture basis."
    },
    {
      "key": "recast:GPN:da",
      "text": "Depreciation and amortisation for FY2023 and FY2024 was re-presented following the divestitures."
    },
    {
      "key": "recast:GPN:tax_expense",
      "text": "Tax expense for FY2023 and FY2024 was re-presented following the divestitures."
    },
    {
      "key": "shares_V",
      "text": "Visa does not tag a diluted share count or diluted EPS in XBRL at or before the cutoff. Its per-share intrinsic value is withheld rather than estimated; an attested cover-page share count would be required to publish one."
    }
  ],
